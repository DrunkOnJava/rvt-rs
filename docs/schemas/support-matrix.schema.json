{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://drunkonjava.github.io/rvt-rs/schemas/support-matrix.schema.json",
  "title": "rvt-rs executable support matrix",
  "description": "Machine-readable capability statuses for rvt-rs. Seeded from docs/status.md / ROADMAP honesty (COR-001). Consumers and tests must not claim stronger status than this matrix (TEST-001 / DOC-001).",
  "type": "object",
  "required": [
    "schema_version",
    "matrix_id",
    "reviewed",
    "status_vocabulary",
    "audit_controls",
    "honesty_invariants",
    "capabilities"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1,
      "description": "Matrix document schema version. Bump on incompatible shape changes."
    },
    "matrix_id": {
      "type": "string",
      "const": "rvt-rs-support-matrix"
    },
    "reviewed": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
      "description": "ISO date of last human review against docs/status.md."
    },
    "description": {
      "type": "string"
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "description": "Human docs this matrix was seeded from."
    },
    "status_vocabulary": {
      "type": "array",
      "minItems": 5,
      "items": {
        "type": "string",
        "enum": [
          "verified",
          "partial",
          "experimental",
          "unsupported",
          "unknown"
        ]
      },
      "uniqueItems": true
    },
    "audit_controls": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      },
      "description": "Unified Repository Audit control IDs this matrix satisfies."
    },
    "honesty_invariants": {
      "type": "object",
      "required": [
        "never_verified_capability_ids",
        "max_status_by_capability_id"
      ],
      "additionalProperties": false,
      "properties": {
        "never_verified_capability_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "Capability ids that must never be marked verified (COR-001)."
        },
        "max_status_by_capability_id": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "enum": [
              "verified",
              "partial",
              "experimental",
              "unsupported",
              "unknown"
            ]
          },
          "description": "Hard ceiling per capability id. Seeded status must not exceed this rank."
        }
      }
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/capability"
      }
    }
  },
  "$defs": {
    "capability": {
      "type": "object",
      "required": [
        "id",
        "area",
        "name",
        "status",
        "evidence",
        "notes"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$",
          "description": "Stable kebab-case capability id."
        },
        "area": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "enum": [
            "verified",
            "partial",
            "experimental",
            "unsupported",
            "unknown"
          ]
        },
        "evidence": {
          "type": "string",
          "minLength": 1,
          "description": "Short pointer to tests, corpus, or reports that justify the status."
        },
        "notes": {
          "type": "string",
          "minLength": 1
        },
        "user_impact": {
          "type": "string"
        }
      }
    }
  }
}
