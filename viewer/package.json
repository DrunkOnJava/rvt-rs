{
  "name": "rvt-viewer",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "In-browser Revit viewer powered by rvt-rs compiled to WebAssembly. Zero upload — every byte stays in the tab.",
  "license": "Apache-2.0",
  "scripts": {
    "stage:demos": "node scripts/stage-demos.mjs",
    "predev": "npm run stage:demos",
    "dev": "vite",
    "prebuild": "npm run stage:demos",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test:browser": "playwright test --config playwright.config.ts",
    "test:network": "npm run test:browser",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "three": "^0.169.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/three": "^0.169.0",
    "typescript": "^5.6.0",
    "vite": "^8.2.2"
  }
}
